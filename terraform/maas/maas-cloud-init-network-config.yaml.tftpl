version: 2
ethernets:
  eth0:
      dhcp4: false
      addresses:
      - ${maas_ipv4_host_address}/24
      routes:
        - to: default
          via: ${maas_ipv4_gateway_address}
      nameservers:
        addresses:
          - ${maas_ipv4_dns}
  eth1:
      dhcp4: false
      addresses:
      - ${maas_ipv4_ext_host_address}/24